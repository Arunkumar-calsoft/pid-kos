# config/storage.yaml
#
# PURPOSE:
#   Tells the pipeline where to find P&ID source files (GraphML drawings + images).
#   All file paths stored inside Neo4j are RELATIVE to store_root, so you only
#   need to change this one value if you move the files to another machine or share.
#
# REQUIRED FOLDER STRUCTURE under store_root:
#
#   pid_store/
#   └── <PLANT_ID>/               e.g. PLANT_001
#       └── <SKID_ID>/            e.g. SKID_01
#           └── <PID_ID>/         e.g. PID_0
#               ├── <name>.graphml    ← graph topology (nodes + edges)
#               └── <name>.png        ← drawing image shown in the web UI
#
# USED BY:
#   - scripts/register_pid.py     → registers a new PID into Neo4j
#   - engine/phase0_ingestion/    → reads the GraphML file during ingestion
#   - server.py                   → serves the PNG image to the browser UI
#   - editor_server.py            → serves image + GraphML in the admin editor
#
# HOW TO SET IT UP:
#   1. Copy this file to config/storage.yaml
#   2. Set store_root to the absolute path of your pid_store folder
#   3. Place your drawings under the folder structure above
#   4. Run: python scripts/register_pid.py PLANT_001 SKID_01 PID_0 path/to/drawing.graphml

storage:
  store_root: "C:/absolute/path/to/your/pid_store"
  # Windows example: "C:/Users/yourname/project/pid_store"
  # Linux example:   "/home/yourname/project/pid_store"
